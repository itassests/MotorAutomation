# Future Generali / RateExtract — environment variables
#
# Convert to a real .env file OR set these on the IIS Application Pool
# (Application Pool Identity must read them). Easiest is to define them
# as **machine-level** environment variables, then restart IIS so iisnode
# picks them up.
#
# IMPORTANT: do NOT commit a real .env file. This sample uses placeholder
# values only.

# ---------- Database (MSSQL) ----------
DB_HOST=10.0.0.10
DB_PORT=1433
DB_NAME=RateExtract
DB_USER=rateextract_app
DB_PASSWORD=********
DB_CONNECT_TIMEOUT=30000
DB_REQUEST_TIMEOUT=120000
DB_TRUST_CERT=true

# ---------- App ----------
# PORT is set automatically by iisnode — do NOT hard-code it here.
UPLOAD_DIR=D:\inetpub\sites\points.oneinsure.com\uploads

# ---------- Anthropic LLM enrichment (optional) ----------
# Leave blank to disable LLM-based remark parsing fallback.
ANTHROPIC_API_KEY=

# ---------- Beeinsured / Prarambh integrations (optional) ----------
BEEINSURED_DB_HOST=
BEEINSURED_DB_NAME=
BEEINSURED_DB_USER=
BEEINSURED_DB_PASSWORD=

PRARAMBH_DB_HOST=
PRARAMBH_DB_NAME=
PRARAMBH_DB_USER=
PRARAMBH_DB_PASSWORD=

# ---------- Bulk OCR worker ----------
# Set OCR_WORKER_ENABLED=1 ONLY on the OCR file machine (the box that has the
# uploaded policy PDFs on disk), and turn the legacy OCR processor OFF there so
# the two don't double-process. Leave it unset/0 everywhere else.
OCR_WORKER_ENABLED=0

# OneInsure OCR endpoints. The code defaults to PRODUCTION (no auth), so these
# are optional — set them only to override (e.g. point at UAT for testing).
#   PROD: https://oneerpapi.oneinsure.com/api/master/GetFileInJson
#         https://oneerpapi.oneinsure.com/api/master/GetOCRdata
OCR_GETFILE_URL=
OCR_GETOCR_URL=

# Where the worker looks for a folder's PDFs/zips (";"-separated). Defaults to
# the dropzone under UPLOAD_DIR. Point at the legacy pickup share if needed.
OCR_SOURCE_DIRS=
# OCR_ZIP_DROP_DIR=

# Empcode that mints trackers for legacy portal folders whose PortalUserId is an
# agent code (not a Bugnet_userprofiles user). The "Process now" button overrides
# this with the clicking operator's empcode.
OCR_TRACKER_EMPCODE=

# Worker pacing (optional; defaults shown).
# OCR_WORKER_TICK_MS=8000
# OCR_FOLDERS_PER_TICK=1
# OCR_PDFS_PER_TICK=3
# OCR_MAX_RETRY=3
